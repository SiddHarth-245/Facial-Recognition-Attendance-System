# =============================================================================
# FaceAttend - Brevo Transactional Email Configuration
# =============================================================================
# Instructions:
# 1. Sign up for a free account at https://www.brevo.com/ (300 free emails/day)
# 2. Add and verify your sender email under "Senders & IP":
#    https://app.brevo.com/senders
# 3. Generate a new API Key (v3) under "SMTP & API" -> "API Keys":
#    https://app.brevo.com/settings/keys/api
# 4. Copy this file to '.env' (in the project root) and replace the values below.
#
# NOTE: Never commit your real '.env' file to Git or version control!
# =============================================================================

# Brevo v3 REST API Key (starts with xkeysib-...)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Verified Sender Email Address (MUST be verified in your Brevo account)
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Sender Display Name shown in recipient inbox
BREVO_SENDER_NAME=FaceAttend Biometrics - KIIT University

# Optional institutional and mentor details for email templates
BREVO_INSTITUTION_NAME=School of Computer Engineering, KIIT University
BREVO_MENTOR_NAME=Project Mentor
